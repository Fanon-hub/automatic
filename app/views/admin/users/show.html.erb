<h1>User Details Page</h1>

<p>Name: <%= @user.name %></p>
<p>Email address: <%= @user.email %></p>
<p>Administrator privileges: <%= @user.admin? ? "Yes" : "None" %></p>

<h2>Tasks</h2>
<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Content</th>
      <th>Creation date</th>
      <th>Expiration date</th>
      <th>Priority</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @user.tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Back", admin_users_path %> 