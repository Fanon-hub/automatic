<!DOCTYPE html>
<html>
  <head>
    <title>TaskManager</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Global Navigation -->
    <header>
      <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="/">Task App</a>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item"><%= link_to 'Task List', tasks_path, class: 'nav-link' %></li>
            <li class="nav-item"><%= link_to 'Register a task', new_task_path, class: 'nav-link' %></li>
            <li class="nav-item"><%= link_to 'Label List', labels_path, class: 'nav-link', id: 'labels-index' %></li>
            <li class="nav-item"><%= link_to 'Register a label', new_label_path, class: 'nav-link', id: 'new-label' %></li>
            <li class="nav-item"><%= link_to 'Account details', user_path, class: 'nav-link' %></li>
            <li class="nav-item"><%= link_to 'Logout', logout_path, class: 'nav-link' %></li>
          </ul>
        </div>
      </nav>
    </header>

    <% if flash.any? %>
      <div class="container mt-3">
        <% flash.each do |key, value| %>
          <div class="alert alert-<%= flash_class(key) %> alert-dismissible fade show" role="alert">
            <%= value %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
