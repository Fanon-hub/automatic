<h1>Label List Page</h1>
<table class="table table-striped table-hover table-bordered">
  <thead class="thead-light">
    <tr>
      <th>Name</th>
      <th>Number of Tasks</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.count %></td>
        <td>
            <%= link_to 'edit', edit_label_path(label), class: 'btn btn-success btn-sm edit-label' %>
            <%= link_to 'delete', label_path(label), method: :delete, data: { confirm: 'Are you sure you want to delete this?' }, class: 'btn btn-danger btn-sm destroy-label' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>