<h1>Task List</h1>

<%= form_with url: tasks_path, method: :get, scope: :search do |f| %>
  <div>
    <%= f.label :title, 'Title', for: 'search_title' %>
    <%= f.text_field :title, class: 'form-control', id: 'search_title' %>
  </div>
  <div>
    <%= f.label :status, 'Status', for: 'search_status' %>
    <%= f.select :status, Task.statuses.keys.map { |k| [t("enums.task.status.#{k}"), k] }, { include_blank: true }, class: 'form-control', id: 'search_status' %>
  </div>
  <div>
    <%= f.label :label_id, 'Label', for: 'search_label' %>
    <%= f.select :label_id, options_from_collection_for_select(current_user.labels, :id, :name), { include_blank: true }, class: 'form-control', id: 'search_label' %>
  </div>
  <div>
    <%= f.label :priority, 'Priority', for: 'search_priority' %>
    <%= f.select :priority, Task.priorities.keys.map { |k| [t("enums.task.priority.#{k}"), k] }, { include_blank: true }, class: 'form-control', id: 'search_priority' %>
  </div>
  <div style="margin-top: 1rem;">
    <%= f.submit 'Search', id: 'search_task', class: 'btn btn-primary' %>
  </div>
<% end %>

<table class="table table-striped table-hover table-bordered">
  <thead class="thead-light">
    <tr>
      <th>Title</th>
      <th><%= link_to "Deadline", tasks_path(sort_deadline: true) %></th>
      <th><%= link_to "Priority", tasks_path(sort_priority: true) %></th>

      <th>Status</th>
      <th>Created At</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.deadline_on %></td>
        <td><%= t("enums.task.priority.#{task.priority}") %></td>
        <td><%= t("enums.task.status.#{task.status}") %></td>
        <td><%= task.created_at %></td>
        <td>
          <%= link_to 'Show', task_path(task), class: 'btn btn-info btn-sm' %>
          <%= link_to 'Edit', edit_task_path(task), class: 'btn btn-success btn-sm' %>
          <%= link_to 'Delete', task_path(task), 
                      method: :delete, 
                      data: { confirm: 'Are you sure you want to delete this task?' }, 
                      class: 'btn btn-danger btn-sm' %>
          
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @tasks, params: request.query_parameters %>