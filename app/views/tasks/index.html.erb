<h1>タスク一覧</h1>

<%= form_with url: tasks_path, method: :get, scope: :search do |f| %>
  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :status, "ステータス" %>
    <%= f.select :status, Task.statuses.keys.map { |k| [t("enums.task.status.#{k}"), k] }, include_blank: true %>
  </div>
  <%= f.submit "検索", id: "search_task" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>タイトル</th>
      <th><%= link_to "終了期限", tasks_path(sort_deadline_on: true) %></th>
      <th><%= link_to "優先度", tasks_path(sort_priority: true) %></th>
      <th>ステータス</th>
      <th>作成日時</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.deadline_on %></td>
        <td><%= t("enums.task.priority.#{task.priority}") %></td>
        <td><%= t("enums.task.status.#{task.status}") %></td>
        <td><%= task.created_at %></td>
        <td>
          <%= link_to '詳細', task %>
          <%= link_to '編集', edit_task_path(task) %>
          <%= link_to '削除', task, method: :delete, data: { confirm: '削除しますか？' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>